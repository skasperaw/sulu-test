{% extends 'base.html.twig' %}

{%- block content -%}
    <h1>{{- content.title -}}</h1>

    {{- content.article|sanitize_html('sulu_wysiwyg')|raw -}}

    {%- for block in content.blocks -%}
        {%- if block.type == 'text_media' -%}
            {{- include('pages/partials/text-media-block.html.twig', { block: block }) -}}
        {%- endif -%}
    {%- endfor -%}
{%- endblock -%}
