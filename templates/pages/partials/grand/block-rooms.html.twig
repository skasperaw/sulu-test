<section class="rooms section-pad" id="zimmer">
    <div class="wrap">
        <div class="section-head">
            <div class="reveal">
                {%- if block.eyebrow -%}
                    <div class="eyebrow"><span class="rule" aria-hidden="true"></span>{{- block.eyebrow -}}</div>
                {%- endif -%}
            </div>
            <div class="reveal d1">
                <h2>{{- block.headline|default('112 Zimmer. Jedes') -}} <em>{{- block.headline_italic|default('ein Unikat.') -}}</em></h2>
                {%- if block.description -%}
                    <p class="desc" style="margin-top:24px">{{- block.description -}}</p>
                {%- endif -%}
            </div>
        </div>

        <div class="rooms-grid">
            {%- for i in 1..5 -%}
                {%- set roomNum   = attribute(block, 'room' ~ i ~ '_number') -%}
                {%- set roomTitle = attribute(block, 'room' ~ i ~ '_title') -%}
                {%- set roomMeta  = attribute(block, 'room' ~ i ~ '_meta') -%}
                {%- set roomPrice = attribute(block, 'room' ~ i ~ '_price') -%}
                {%- set roomImg   = attribute(block, 'room' ~ i ~ '_image') -%}
                {%- set fallbacks = [
                    'https://images.unsplash.com/photo-1631049307264-da0ec9d70304?auto=format&fit=crop&w=1600&q=80',
                    'https://images.unsplash.com/photo-1611892440504-42a792e24d32?auto=format&fit=crop&w=1600&q=80',
                    'https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=1200&q=80',
                    'https://images.unsplash.com/photo-1566665797739-1674de7a421a?auto=format&fit=crop&w=1200&q=80',
                    'https://images.unsplash.com/photo-1618773928121-c32242e63f39?auto=format&fit=crop&w=1200&q=80'
                ] -%}
                {%- set imgSrc = roomImg and roomImg.id ? roomImg.thumbnails['room_card'] : fallbacks[i - 1] -%}
                {%- set imgAlt = roomImg and roomImg.id ? roomImg.description|default(roomImg.title)|default('') : '' -%}
                {%- set colClass = i <= 2 ? 'c' ~ i : 'c' ~ i -%}

                <article class="room {{ colClass }}{% if i <= 2 %} wide{% endif %} reveal{% if i > 1 %} d{{ [0,1,0,1,2][i-1] }}{% endif %}">
                    <div class="photo">
                        {%- if roomNum -%}<span class="num" aria-hidden="true">{{- roomNum -}}</span>{%- endif -%}
                        <img src="{{ imgSrc }}" alt="{{ imgAlt }}" loading="lazy" width="800">
                        <div class="arrow" aria-hidden="true">
                            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M3 11L11 3M5 3h6v6"/></svg>
                        </div>
                    </div>
                    <div class="info">
                        <div>
                            {%- if roomTitle -%}<h3>{{- roomTitle -}}</h3>{%- endif -%}
                            {%- if roomMeta -%}<div class="meta">{{- roomMeta -}}</div>{%- endif -%}
                        </div>
                        {%- if roomPrice -%}
                            <div class="price"><small>ab</small><strong>{{ roomPrice }}</strong></div>
                        {%- endif -%}
                    </div>
                </article>
            {%- endfor -%}
        </div>
    </div>
</section>
